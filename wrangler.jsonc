{
  // Deploy settings for the Cloudflare Worker "events-to-cover".
  "name": "events-to-cover",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Picks storage: the "ccmc-claims" KV namespace.
  "kv_namespaces": [{ "binding": "CLAIMS", "id": "0d539cd0558b444b8aed79c9ee5ea6aa" }]
}
